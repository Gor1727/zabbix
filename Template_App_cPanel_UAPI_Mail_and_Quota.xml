<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>6.0</version>
    <date>2026-11-05T09:30:00Z</date>
    <groups>
        <group>
            <uuid>7df96b18c230490a9a0a9e2307226338</uuid>
            <name>Templates</name>
        </group>
    </groups>
    <templates>
        <template>
            <uuid>a1b2c3d4e5f6471892a3b4c5d6e7f801</uuid>
            <template>Template App cPanel UAPI Mail and Quota</template>
            <name>Template App cPanel UAPI Mail and Quota</name>
            <description>Мониторинг квоты диска аккаунта cPanel, автообнаружение (LLD) почтовых ящиков и отслеживание критических ошибок доставки через UAPI / API 2 без внешних скриптов.</description>
            <groups>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <items>
                <!-- MASTER ITEM 1: Account Quota -->
                <item>
                    <uuid>11111111222243338444555555550001</uuid>
                    <name>cPanel: Get Quota Info (Raw JSON)</name>
                    <type>HTTP_AGENT</type>
                    <key>cpanel.uapi.quota.raw</key>
                    <delay>5m</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <url>{$CPANEL.URL}/execute/Quota/get_quota_info</url>
                    <headers>
                        <header>
                            <name>Authorization</name>
                            <value>cpanel {$CPANEL.USER}:{$CPANEL.TOKEN}</value>
                        </header>
                    </headers>
                </item>
                <item>
                    <uuid>11111111222243338444555555550002</uuid>
                    <name>cPanel: API Quota Status</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.uapi.quota.status</key>
                    <delay>0</delay>
                    <history>7d</history>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                        <key>cpanel.uapi.quota.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.status</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <triggers>
                        <trigger>
                            <uuid>11111111222243338444555555559001</uuid>
                            <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.uapi.quota.status)=0</expression>
                            <name>cPanel: Ошибка выполнения API-запроса Quota (проверьте токен или права)</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>11111111222243338444555555550003</uuid>
                    <name>cPanel: Disk Space Used (MB)</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.quota.used.mb</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>FLOAT</value_type>
                    <units>MB</units>
                    <master_item>
                        <key>cpanel.uapi.quota.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.data.megabytes_used</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
                <item>
                    <uuid>11111111222243338444555555550004</uuid>
                    <name>cPanel: Disk Space Limit (MB)</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.quota.limit.mb</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>FLOAT</value_type>
                    <units>MB</units>
                    <master_item>
                        <key>cpanel.uapi.quota.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.data.megabyte_limit</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
                <item>
                    <uuid>11111111222243338444555555550005</uuid>
                    <name>cPanel: Disk Space Remaining (MB)</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.quota.remain.mb</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>FLOAT</value_type>
                    <units>MB</units>
                    <master_item>
                        <key>cpanel.uapi.quota.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.data.megabytes_remain</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
                <item>
                    <uuid>11111111222243338444555555550006</uuid>
                    <name>cPanel: Account Disk Usage (%)</name>
                    <type>CALCULATED</type>
                    <key>cpanel.quota.used.pct</key>
                    <delay>5m</delay>
                    <history>30d</history>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <params>100 * last(//cpanel.quota.used.mb) / last(//cpanel.quota.limit.mb)</params>
                    <triggers>
                        <trigger>
                            <uuid>11111111222243338444555555559002</uuid>
                            <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.quota.used.pct)&gt;={$CPANEL.DISK.CRIT}</expression>
                            <name>cPanel: Критически мало места на диске аккаунта ({ITEM.LASTVALUE})</name>
                            <priority>HIGH</priority>
                        </trigger>
                        <trigger>
                            <uuid>11111111222243338444555555559003</uuid>
                            <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.quota.used.pct)&gt;={$CPANEL.DISK.WARN}</expression>
                            <name>cPanel: Заканчивается место на диске аккаунта ({ITEM.LASTVALUE})</name>
                            <priority>WARNING</priority>
                            <dependencies>
                                <dependency>
                                    <name>cPanel: Критически мало места на диске аккаунта ({ITEM.LASTVALUE})</name>
                                    <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.quota.used.pct)&gt;={$CPANEL.DISK.CRIT}</expression>
                                </dependency>
                            </dependencies>
                        </trigger>
                    </triggers>
                </item>

                <!-- MASTER ITEM 2: Mailboxes List (Raw JSON) -->
                <item>
                    <uuid>11111111222243338444555555550010</uuid>
                    <name>cPanel: Get Mailboxes Disk Info (Raw JSON)</name>
                    <type>HTTP_AGENT</type>
                    <key>cpanel.uapi.mailboxes.raw</key>
                    <delay>5m</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <url>{$CPANEL.URL}/execute/Email/list_pops_with_disk</url>
                    <headers>
                        <header>
                            <name>Authorization</name>
                            <value>cpanel {$CPANEL.USER}:{$CPANEL.TOKEN}</value>
                        </header>
                    </headers>
                </item>

                <!-- MASTER ITEM 3: EmailTrack Stats (Raw JSON) -->
                <item>
                    <uuid>11111111222243338444555555550020</uuid>
                    <name>cPanel: Get EmailTrack Stats (Raw JSON)</name>
                    <type>HTTP_AGENT</type>
                    <key>cpanel.api2.emailtrack.raw</key>
                    <delay>5m</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <url>{$CPANEL.URL}/json-api/cpanel?cpanel_jsonapi_apiversion=2&amp;cpanel_jsonapi_module=EmailTrack&amp;cpanel_jsonapi_func=stats</url>
                    <headers>
                        <header>
                            <name>Authorization</name>
                            <value>cpanel {$CPANEL.USER}:{$CPANEL.TOKEN}</value>
                        </header>
                    </headers>
                </item>
                <item>
                    <uuid>11111111222243338444555555550021</uuid>
                    <name>cPanel Mail: Successful Deliveries</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.mail.success</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                        <key>cpanel.api2.emailtrack.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.cpanelresult.data[0].SUCCESSCOUNT</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
                <item>
                    <uuid>11111111222243338444555555550022</uuid>
                    <name>cPanel Mail: Failed Deliveries (Bounces)</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.mail.fail</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                        <key>cpanel.api2.emailtrack.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.cpanelresult.data[0].FAILCOUNT</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <triggers>
                        <trigger>
                            <uuid>11111111222243338444555555559004</uuid>
                            <expression>(last(/Template App cPanel UAPI Mail and Quota/cpanel.mail.fail)-min(/Template App cPanel UAPI Mail and Quota/cpanel.mail.fail,15m))&gt;={$CPANEL.MAIL.FAIL.BURST}</expression>
                            <name>cPanel Mail: Резкий рост ошибок доставки писем (FAILCOUNT +{ITEM.LASTVALUE} за 15м)</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>11111111222243338444555555550023</uuid>
                    <name>cPanel Mail: Deferred Emails</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.mail.defer</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                        <key>cpanel.api2.emailtrack.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.cpanelresult.data[0].DEFERCOUNT</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
                <item>
                    <uuid>11111111222243338444555555550024</uuid>
                    <name>cPanel Mail: In-Progress Emails (Queue)</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.mail.inprogress</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                        <key>cpanel.api2.emailtrack.raw</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.cpanelresult.data[0].INPROGRESSCOUNT</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <uuid>22222222333344448555666666660001</uuid>
                    <name>cPanel Mailboxes Discovery</name>
                    <type>DEPENDENT</type>
                    <key>cpanel.mailboxes.lld</key>
                    <delay>0</delay>
                    <master_item>
                        <key>cpanel.uapi.mailboxes.raw</key>
                    </master_item>
                    <lld_macro_paths>
                        <lld_macro_path>
                            <lld_macro>{#EMAIL}</lld_macro>
                            <path>$.email</path>
                        </lld_macro_path>
                    </lld_macro_paths>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.data</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>22222222333344448555666666660011</uuid>
                            <name>Mailbox [{#EMAIL}]: Disk Usage (%)</name>
                            <type>DEPENDENT</type>
                            <key>cpanel.mailbox.used.pct[{#EMAIL}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <master_item>
                                <key>cpanel.uapi.mailboxes.raw</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.data[?(@.email=="{#EMAIL}")].diskusedpercent.first()</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>22222222333344448555666666669001</uuid>
                                    <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.mailbox.used.pct[{#EMAIL}])&gt;={$CPANEL.MAILBOX.CRIT}</expression>
                                    <name>Mailbox [{#EMAIL}]: Критически мало места ({ITEM.LASTVALUE})</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                                <trigger_prototype>
                                    <uuid>22222222333344448555666666669002</uuid>
                                    <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.mailbox.used.pct[{#EMAIL}])&gt;={$CPANEL.MAILBOX.WARN}</expression>
                                    <name>Mailbox [{#EMAIL}]: Заканчивается место в ящике ({ITEM.LASTVALUE})</name>
                                    <priority>WARNING</priority>
                                    <dependencies>
                                        <dependency>
                                            <name>Mailbox [{#EMAIL}]: Критически мало места ({ITEM.LASTVALUE})</name>
                                            <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.mailbox.used.pct[{#EMAIL}])&gt;={$CPANEL.MAILBOX.CRIT}</expression>
                                        </dependency>
                                    </dependencies>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>22222222333344448555666666660012</uuid>
                            <name>Mailbox [{#EMAIL}]: Disk Used (Bytes)</name>
                            <type>DEPENDENT</type>
                            <key>cpanel.mailbox.used.bytes[{#EMAIL}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <value_type>UNSIGNED</value_type>
                            <units>B</units>
                            <master_item>
                                <key>cpanel.uapi.mailboxes.raw</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.data[?(@.email=="{#EMAIL}")]._diskused.first()</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>22222222333344448555666666660013</uuid>
                            <name>Mailbox [{#EMAIL}]: Incoming Mail Suspended</name>
                            <type>DEPENDENT</type>
                            <key>cpanel.mailbox.suspended_incoming[{#EMAIL}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <value_type>UNSIGNED</value_type>
                            <master_item>
                                <key>cpanel.uapi.mailboxes.raw</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.data[?(@.email=="{#EMAIL}")].suspended_incoming.first()</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>22222222333344448555666666669003</uuid>
                                    <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.mailbox.suspended_incoming[{#EMAIL}])=1</expression>
                                    <name>Mailbox [{#EMAIL}]: Входящая почта заблокирована (Suspended Incoming)</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>22222222333344448555666666660014</uuid>
                            <name>Mailbox [{#EMAIL}]: Login Suspended</name>
                            <type>DEPENDENT</type>
                            <key>cpanel.mailbox.suspended_login[{#EMAIL}]</key>
                            <delay>0</delay>
                            <history>30d</history>
                            <value_type>UNSIGNED</value_type>
                            <master_item>
                                <key>cpanel.uapi.mailboxes.raw</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.data[?(@.email=="{#EMAIL}")].suspended_login.first()</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>22222222333344448555666666669004</uuid>
                                    <expression>last(/Template App cPanel UAPI Mail and Quota/cpanel.mailbox.suspended_login[{#EMAIL}])=1</expression>
                                    <name>Mailbox [{#EMAIL}]: Авторизация в ящик заблокирована (Suspended Login)</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
            <macros>
                <macro>
                    <macro>{$CPANEL.DISK.CRIT}</macro>
                    <value>98</value>
                    <description>Критический порог заполнения общей квоты аккаунта (%)</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.DISK.WARN}</macro>
                    <value>90</value>
                    <description>Предупредительный порог заполнения общей квоты аккаунта (%)</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.MAIL.FAIL.BURST}</macro>
                    <value>20</value>
                    <description>Порог резкого прироста ошибок доставки писем за 15 минут</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.MAILBOX.CRIT}</macro>
                    <value>95</value>
                    <description>Критический порог заполнения почтового ящика (%)</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.MAILBOX.WARN}</macro>
                    <value>80</value>
                    <description>Предупредительный порог заполнения почтового ящика (%)</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.TOKEN}</macro>
                    <value>CHANGE_ME_API_TOKEN</value>
                    <description>API-токен пользователя cPanel (Security -&gt; Manage API Tokens)</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.URL}</macro>
                    <value>https://mail.restconcept.am:2083</value>
                    <description>URL сервера cPanel с портом 2083 (без слэша на конце)</description>
                </macro>
                <macro>
                    <macro>{$CPANEL.USER}</macro>
                    <value>CHANGE_ME_USERNAME</value>
                    <description>Имя пользователя (логин) аккаунта cPanel</description>
                </macro>
            </macros>
        </template>
    </templates>
</zabbix_export>
